# ============================================================
#  SWARA (Sistem WhatsApp Responsif & Akurat) — Konfigurasi Rahasia
#  Salin file ini menjadi ".env" lalu isi nilainya.
#  JANGAN commit file .env ke git.
# ============================================================

# Port server
PORT=3000

# Rahasia session (WAJIB diganti dengan string acak panjang)
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang-dan-unik

# --- Google OAuth 2.0 (opsional) ---
# Dapatkan dari https://console.cloud.google.com (OAuth Client ID - Web application)
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- Daily Push Notification (PML/Supervisor) ---
# Nomor WhatsApp PML yang menerima laporan harian (format 08xxx atau 62xxx)
SUPERVISOR_PHONE=
# Jadwal cron (default 17:00). Format: menit jam * * *
DAILY_PUSH_CRON=0 17 * * *
# Zona waktu cron (Bali = WITA)
CRON_TIMEZONE=Asia/Makassar

# --- Cadangan basis data otomatis ---
# Salinan data/audit.sqlite disimpan ke data/backup/audit-YYYY-MM-DD.sqlite
# Jadwal cron (default 02:00 dini hari, saat sistem sepi)
BACKUP_CRON=0 2 * * *
# Berapa hari cadangan disimpan sebelum yang terlama dibuang
BACKUP_KEEP=14
