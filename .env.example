# ============================================================
#  SWARA (Sistem WhatsApp Responsif & Akurat) — Konfigurasi Rahasia
#  Salin file ini menjadi ".env" lalu isi nilainya.
#  JANGAN commit file .env ke git.
# ============================================================

# Port server
PORT=3000

# --- Akses dari luar kantor (alamat publik) ---------------------------------
# TIDAK ADA variabel yang perlu diisi di sini. Aplikasi menyusun alamatnya
# sendiri dari permintaan yang masuk (req.protocol + Host), sehingga tautan
# reset password otomatis memakai alamat publik yang benar begitu SWARA
# diakses lewat terowongan Cloudflare.
#
# Syaratnya sudah dipenuhi di app.js:
#   - app.set('trust proxy', 1)  -> header X-Forwarded-Proto milik tunnel dibaca
#   - cookie.secure = 'auto'     -> cookie ditandai Secure hanya bila HTTPS
# JANGAN memaksa cookie.secure menjadi true; lihat catatan panjang di app.js.
#
# Cara menyalakan alamat publik: jalankan start-swara-tunnel.bat
# (persiapan cloudflared dijelaskan di dalam berkas itu).

# Rahasia session (WAJIB diganti dengan string acak panjang)
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang-dan-unik

# --- Google OAuth 2.0 (opsional) ---
# Dapatkan dari https://console.cloud.google.com (OAuth Client ID - Web application)
# Authorized redirect URI: http://localhost:3000/auth/google/callback
#
# PENTING bila SWARA diakses lewat alamat publik: nilai GOOGLE_CALLBACK_URL di
# bawah HARUS diganti menjadi alamat publiknya, mis.
#   GOOGLE_CALLBACK_URL=https://swara.<domain-anda>/auth/google/callback
# dan alamat yang sama persis didaftarkan sebagai Authorized redirect URI di
# Google Cloud Console. Bila masih localhost, login Google gagal dengan
# redirect_uri_mismatch. Login email/password tidak terpengaruh.
#
# Dibiarkan kosong = Google OAuth tidak diaktifkan sama sekali (bawaan).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- Daily Push Notification (PML/Supervisor) ---
# Nomor WhatsApp PML yang menerima laporan harian (format 08xxx atau 62xxx)
SUPERVISOR_PHONE=
# Jadwal cron (default 17:00). Format: menit jam * * *
DAILY_PUSH_CRON=0 17 * * *
# Zona waktu cron (Bali = WITA)
CRON_TIMEZONE=Asia/Makassar

# --- Cadangan basis data otomatis ---
# Salinan data/audit.sqlite disimpan ke data/backup/audit-YYYY-MM-DD.sqlite
# Jadwal cron (default 02:00 dini hari, saat sistem sepi)
BACKUP_CRON=0 2 * * *
# Berapa hari cadangan disimpan sebelum yang terlama dibuang
BACKUP_KEEP=14
